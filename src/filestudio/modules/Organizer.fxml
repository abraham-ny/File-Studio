<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="filestudio.modules.OrganizerController">
    <children>
        <TextField fx:id="dirPathTbx" layoutX="11.0" layoutY="14.0" prefHeight="25.0" prefWidth="465.0" promptText="Path to folder" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="124.0" AnchorPane.topAnchor="14.0" />
        <Button fx:id="browseBtn" onAction="#pdir" layoutX="485.0" layoutY="14.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="104.0" text="Browse" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="14.0" />
        <TextField fx:id="regexInput" layoutX="11.0" layoutY="56.0" prefHeight="25.0" prefWidth="465.0" promptText="Custom Regex to use (optional)" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="124.0" AnchorPane.topAnchor="56.0" />
        <CheckBox fx:id="regexCheck" layoutX="485.0" layoutY="60.0" mnemonicParsing="false" prefHeight="17.0" prefWidth="104.0" text="Use Regex" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="60.0" />
        <ComboBox fx:id="fileTypesCbx" layoutX="11.0" layoutY="93.0" prefWidth="150.0" promptText="File Types" AnchorPane.leftAnchor="11.0" AnchorPane.topAnchor="93.0" />
        <Button fx:id="destinationBtn" onAction="#launchDestinationSettings" layoutX="485.0" layoutY="93.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="104.0" text="Change Destinations" AnchorPane.rightAnchor="11.0" />
        <Button fx:id="ignoreBtn" onAction="#launchIgnoreListApp" layoutX="375.0" layoutY="93.0" mnemonicParsing="false" text="View Ignore List" AnchorPane.rightAnchor="130.0" AnchorPane.topAnchor="93.0" />
        <TreeView fx:id="organizerTree" layoutX="11.0" layoutY="135.0" prefHeight="226.0" prefWidth="465.0" AnchorPane.bottomAnchor="39.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="124.0" AnchorPane.topAnchor="135.0" />
        <ProgressBar layoutX="14.0" layoutY="368.0" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="23.0" prefWidth="465.0" progress="0.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="121.0" />
        <Button fx:id="organizeBtn" onAction="#organizeDir" layoutX="485.0" layoutY="336.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="104.0" style="-fx-background-color: dodgerblue; -fx-text-fill: white;" text="Organize" AnchorPane.bottomAnchor="39.0" AnchorPane.rightAnchor="11.0" />
        <Button fx:id="scanBtn" onAction="#processDir"  layoutX="485.0" layoutY="301.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="104.0" text="Scan" AnchorPane.bottomAnchor="80.0" AnchorPane.rightAnchor="11.0" />
        <Label layoutX="485.0" layoutY="369.0" prefHeight="17.0" prefWidth="104.0" text="x of total" AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="11.0" />
    </children>
</AnchorPane>
