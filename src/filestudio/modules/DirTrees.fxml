<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="filestudio.modules.DirTreesController">
   <children>
      <TextField fx:id="dirTreePath" layoutX="6.0" layoutY="14.0" prefHeight="25.0" prefWidth="495.0" promptText="Dir tree path" AnchorPane.leftAnchor="6.0" AnchorPane.rightAnchor="99.0" AnchorPane.topAnchor="10.0" />
      <Button fx:id="createDirTreeBtn" defaultButton="true" layoutX="6.0" layoutY="43.0" mnemonicParsing="false" onAction="#createTree" prefHeight="25.0" prefWidth="284.0" text="Create New..." AnchorPane.leftAnchor="6.0" />
      <Button fx:id="browseDirTreeBtn" cancelButton="true" layoutX="313.0" layoutY="43.0" mnemonicParsing="false" onAction="#readTree"  prefHeight="25.0" prefWidth="284.0" text="Browse Existing" AnchorPane.leftAnchor="310.0" />
      <ProgressBar fx:id="dirTreesProgress" layoutX="6.0" layoutY="77.0" prefHeight="20.0" prefWidth="588.0" progress="0.0" AnchorPane.leftAnchor="6.0" AnchorPane.rightAnchor="6.0" />
      <Label fx:id="progressText" alignment="CENTER" contentDisplay="CENTER" focusTraversable="false" layoutX="249.0" layoutY="78.0" prefHeight="20.0" text="Nothing is happening..." textAlignment="CENTER" AnchorPane.leftAnchor="249.0" AnchorPane.rightAnchor="228.0" />
      <CheckBox fx:id="formatCheck" layoutX="513.0" layoutY="14.0" mnemonicParsing="false" text="Smaller File" AnchorPane.rightAnchor="10.0" />
      <ListView fx:id="listView" layoutX="7.0" layoutY="105.0" prefHeight="290.0" prefWidth="588.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="7.0" AnchorPane.rightAnchor="7.0" AnchorPane.topAnchor="105.0" />
   </children>
</AnchorPane>
