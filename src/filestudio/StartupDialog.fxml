<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="anchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="filestudio.StartupDialogController">
   <children>
      <ToolBar prefHeight="40.0" prefWidth="600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <items>
            <TextField fx:id="dirPathTbx" prefHeight="25.0" prefWidth="423.0" promptText="Folder Path" />
            <Button mnemonicParsing="false" onMouseClicked="#pickNewDir" text="Browse..." />
         </items>
      </ToolBar>
      <Label layoutX="14.0" layoutY="55.0" prefHeight="47.0" prefWidth="159.0" text="FileStudio" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="55.0">
         <font>
            <Font name="Century Gothic" size="34.0" />
         </font>
      </Label>
      <ButtonBar layoutY="360.0" prefHeight="40.0" prefWidth="600.0" snapToPixel="false" style="-fx-padding: 10;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <buttons>
            <Button mnemonicParsing="false" onMouseClicked="#continueWithout" text="Continue without Folder" />
            <Button mnemonicParsing="false" onMouseClicked="#openSelected" text="Open Selected" />
         </buttons>
      </ButtonBar>
      <ListView fx:id="recentsListView" layoutX="200.0" layoutY="55.0" prefHeight="296.0" prefWidth="389.0" AnchorPane.bottomAnchor="49.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="55.0" />
      <CheckBox fx:id="showBox" layoutX="14.0" layoutY="334.0" mnemonicParsing="false" onMouseClicked="#showOrNot" text="Show On Startup" AnchorPane.bottomAnchor="49.0" AnchorPane.leftAnchor="14.0" />
   </children>
</AnchorPane>
